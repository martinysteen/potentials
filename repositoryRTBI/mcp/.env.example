# Copy to .env (never committed) and fill in. Restart after any change:
#   sudo systemctl restart rtbi-mcp

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: https://mcp.innovia.dk/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Signs the tokens this server hands to Claude/ChatGPT. Any long random string; changing it
# logs every client out. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RTBI_MCP_JWT_KEY=

# Who may use the server, comma-separated Google account emails (case-insensitive).
# Also add each one as a "Test user" on the Google OAuth consent screen.
RTBI_MCP_ALLOWED_EMAILS=sm@innovia.dk

# Public address, only change if the hostname changes.
RTBI_MCP_BASE_URL=https://mcp.innovia.dk
