#!/bin/bash
# =============================================================================
# pg_backup.sh — PostgreSQL GFS backup script for potsystem
# =============================================================================
# Grandfather-Father-Son retention:
#   Daily   — kept 7 days
#   Weekly  — kept 4 weeks  (runs on Sunday)
#   Monthly — kept 6 months (runs on 1st of month)
#
# Usage (called by cron):
#   Daily:   bash pg_backup.sh daily
#   Weekly:  bash pg_backup.sh weekly
#   Monthly: bash pg_backup.sh monthly
# =============================================================================

set -euo pipefail

# --- Configuration -----------------------------------------------------------
DB_NAME="potsystem"
DB_USER="sm"
BACKUP_DIR="/home/sm/potentials/DB/backups"
RCLONE_REMOTE="asustor:Backup_gandalf-potsystem"
LOG_FILE="/home/sm/potentials/DB/backups/pg_backup.log"

# Retention counts
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# --- Argument ----------------------------------------------------------------
PERIOD="${1:-daily}"   # daily | weekly | monthly

if [[ ! "$PERIOD" =~ ^(daily|weekly|monthly)$ ]]; then
    echo "Usage: $0 [daily|weekly|monthly]" >&2
    exit 1
fi

# --- Setup -------------------------------------------------------------------
mkdir -p "$BACKUP_DIR"
TIMESTAMP=$(date +%Y-%m-%d_%H%M)
FILENAME="potsystem_${TIMESTAMP}_${PERIOD}.sql.gz"
FILEPATH="${BACKUP_DIR}/${FILENAME}"

# --- Log helper --------------------------------------------------------------
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

# --- Dump --------------------------------------------------------------------
log "START: $PERIOD backup → $FILENAME"

pg_dump -U "$DB_USER" -d "$DB_NAME" -F plain \
    | gzip > "$FILEPATH"

SIZE=$(du -sh "$FILEPATH" | cut -f1)
log "DUMP OK: $SIZE"

# --- Push to Asustor via rclone ----------------------------------------------
rclone copy "$FILEPATH" "${RCLONE_REMOTE}/${PERIOD}/"
log "RCLONE OK: pushed to ${RCLONE_REMOTE}/${PERIOD}/"

# --- Prune old local backups -------------------------------------------------
case "$PERIOD" in
    daily)   KEEP=$KEEP_DAILY   ;;
    weekly)  KEEP=$KEEP_WEEKLY  ;;
    monthly) KEEP=$KEEP_MONTHLY ;;
esac

# List files for this period sorted newest-first, delete beyond retention count
ls -t "${BACKUP_DIR}"/potsystem_*_${PERIOD}.sql.gz 2>/dev/null \
    | tail -n +$(( KEEP + 1 )) \
    | xargs -r rm --

log "PRUNED LOCAL: keeping last $KEEP ${PERIOD} backups"

# --- Prune old remote backups ------------------------------------------------
# List remote files, sorted by name (date in name = chronological order)
# Delete files beyond retention count on the remote too
REMOTE_FILES=$(rclone lsf "${RCLONE_REMOTE}/${PERIOD}/" 2>/dev/null | sort)
REMOTE_COUNT=$(echo "$REMOTE_FILES" | grep -c '.sql.gz' || true)

if (( REMOTE_COUNT > KEEP )); then
    TO_DELETE=$(echo "$REMOTE_FILES" | head -n $(( REMOTE_COUNT - KEEP )))
    for f in $TO_DELETE; do
        rclone deletefile "${RCLONE_REMOTE}/${PERIOD}/${f}"
        log "PRUNED REMOTE: deleted ${f}"
    done
fi

log "DONE: $PERIOD backup complete"
log "---"
