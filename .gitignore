# --- Security (NEVER UPLOAD THESE) ---
.env
config.env
*_creds.json

# --- Data (Handled by Rclone) ---
*.csv
*.xlsx
*.db
*.sqlite

# --- Logs (Handled by Rclone Move) ---
*.log
logs/

# --- Python Junk (Compiled files) ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
env/

# --- Editor workspace config (per-user; kept on disk, not tracked) ---
*.code-workspace

# --- System Junk ---
.DS_Store
shared/app/creds/token.json

# --- Mirror state, rewritten by sync_rtbi.sh on every tick ---
repositoryRTBI/mirror_status.json

# --- Run-local input snapshots (rebuilt from repositoryRTBI on every run;
#     see strategy_grp2/app/code/shared/datacheck.py) ---
#     (`**/` not `*/`, so a project keeps them ignored after being moved into _archive/) ---
**/app/data/input/
**/app/data/.input_new/
**/app/data/.input_old/

# --- Archived experiments (files kept on disk, not tracked) ---
correlation/
gainsuccess/

# --- strategy_grp2's control board is a hand-edited INPUT, not generated data — track it
#     despite the blanket *.xlsx rule above (see strategy_grp2/DesignVersion2.md) ---
!strategy_grp2/app/control/control_board.xlsx

# Added by code-review-graph
.code-review-graph/

# --- tunnel: run products (PDF/PNG plots, regenerated by every run) ---
# ... except each selection folder's recipe (tunnel_runs.txt), which is config, not product
tunnel/app/output/*/*
!tunnel/app/output/*/tunnel_runs.txt
# ... also one level down, in group folders (output/personal/SM/tunnel_runs.txt)
!tunnel/app/output/*/*/
tunnel/app/output/*/*/*
!tunnel/app/output/*/*/tunnel_runs.txt
tunnel/app/output.new/
tunnel/app/output.old/
tunnel/handoff/*.pdf

# --- Mirror copy of tunnel's nightly publish (PDF/PNG, ~10 MB, replaced every night) ---
repositoryRTBI/data/Tunnel/
